# ══════════════════════════════════════════════════════════════════════
#  MUSTAQIL ILOVA (APK) SOZLAMALARI
# ══════════════════════════════════════════════════════════════════════
#
# ⚠️ `.env.local` DAN ALOHIDA VA BU ATAYLAB: u yerda proksi rejimi
# (`NEXT_PUBLIC_API_URL=/api`) va u Telegram mini-ilova uchun to'g'ri.
# APK ichida esa Next serveri YO'Q va proksi ishlamaydi.

# ── SERVER ────────────────────────────────────────────────────────────
# ⚠️ TO'LIQ HTTPS MANZIL SHART. Nisbiy manzil bilan qurilgan ilova
# ochiladi, lekin har so'rov muvaffaqiyatsiz bo'ladi.
NEXT_PUBLIC_API_URL=https://nazoratchi-ai-api.mysrv.uz/api

# ── TELEGRAM KIRISHI ──────────────────────────────────────────────────
# Bot nomi (`@` siz) — kirish sahifasi shu bot nomidan ochiladi.
NEXT_PUBLIC_BOT_USERNAME=ViloyatShtabiBot

# Kirish natijasi qaytadigan HTTPS manzil.
# ⚠️ SHU DOMEN BotFather'da `/setdomain` bilan ro'yxatdan o'tgan
# bo'lishi SHART, aks holda Telegram kirish sahifasini ochmaydi.
NEXT_PUBLIC_AUTH_ORIGIN=https://nazoratchi-ai-api.mysrv.uz
